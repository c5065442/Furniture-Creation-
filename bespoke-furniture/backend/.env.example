SECRET_KEY=change-me-to-a-random-secret-in-your-local-.env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Vite auto-increments the port (5174, 5175, ...) if 5173 is already taken by
# another running dev server — list a few fallbacks so a second instance
# doesn't silently fail with CORS errors.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Google Maps Platform key (Geocoding API + Distance Matrix/Directions API).
# Get one at https://console.cloud.google.com/google/maps-apis — leave blank
# during early development; the geocoding/routing services fall back to a
# fake client in tests and will raise a clear error if called without a key.
GOOGLE_MAPS_API_KEY=
